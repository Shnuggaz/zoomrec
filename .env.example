# Copy to .env and adjust. .env is git-ignored.

# Password for the web interface (required)
WEB_PASSWORD=change-me
# 127.0.0.1 = only reachable on the VM (use an SSH tunnel), 0.0.0.0 = reachable in the LAN
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Group id for created files (e.g. 1500 for a shared media group); the user id is always 1000
#PGID=1000

# Name shown to the other participants in Zoom
DISPLAY_NAME=zoomrec

# VNC password for the virtual desktop (port 5901, only on 127.0.0.1)
VNC_PW=zoomrec

# Optional Telegram notifications
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

# Optional: store recordings on a network share that is mounted on the host
#RECORDINGS_PATH=/mnt/nas/zoomrec

# Optional: transcription with Scriberr (create an API key in Scriberr's settings)
#SCRIBERR_URL=https://transcribe.example.com
#SCRIBERR_API_KEY=
# Whisper model: small (fast, CPU), medium, large-v3 (best, needs a GPU in Scriberr)
#SCRIBERR_MODEL=small
#SCRIBERR_DEVICE=cpu
#SCRIBERR_LANGUAGE=de

# Recording quality
#VNC_RESOLUTION=1920x1080
#RECORD_FPS=15
#RECORD_CRF=24
